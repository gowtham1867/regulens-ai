PROJECT_NAME="ReguLens AI"
API_V1_STR="/api/v1"
SECRET_KEY="regulens-ai-secret-key-for-development-only-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM="HS256"

# Database Configuration (PostgreSQL supported, defaults to SQLite for zero-config demonstration)
DATABASE_URL="sqlite:///./regulens.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/regulens"

# Storage Configuration
UPLOAD_DIR="./storage/documents"
MAX_UPLOAD_SIZE_BYTES=15728640  # 15MB

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Regulatory Version
REGULATORY_ACADEMIC_YEAR="2025-2026"

